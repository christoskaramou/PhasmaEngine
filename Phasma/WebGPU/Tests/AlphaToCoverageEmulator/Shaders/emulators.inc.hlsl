// 1:1 HLSL translations of every alpha-to-coverage emulator algorithm from
// webgpu-samples/alpha-to-coverage-emulator src/emulatedAlphaToCoverage.ts.
//
// Each function maps (alpha, xy_pixel_coord) -> sample mask (uint). The WGSL
// originals are matched constant-for-constant; only the surface syntax is
// HLSL. None of these are compiled into the default-preset pipeline (mode =
// native), but they are shipped beside the sample so the port is content-
// complete per the webgpu-samples porting convention.
//
// Variants ported:
//   - Alpha test @ 50%
//   - NVIDIA GeForce RTX 3070        (1D threshold table)
//   - Intel HD Graphics 4400         (1D threshold table)
//   - Apple M1 Pro                   (2x2 dither)
//   - Imagination PowerVR Rogue GE8300 (2x2 dither, same table as Apple)
//   - ARM Mali-G78                   (2x2 dither)
//   - AMD Radeon RX 580              (2x2 dither)
//   - AMD Radeon 890M                (4x4 dither)
//   - Qualcomm Adreno 630            (4x4 dither)

#ifndef PE_EMULATORS_INC
#define PE_EMULATORS_INC

// --- alpha-test 50% --------------------------------------------------------
uint EmulatedAlphaTest(float alpha, uint2 xy)
{
    if (alpha < 0.5f) return 0u;
    return 0xfu;
}

// --- NVIDIA GeForce RTX 3070 ----------------------------------------------
uint EmulatedA2C_NVIDIA_RTX3070(float alpha, uint2 xy)
{
    if (alpha <  253.0f / 2048.0f) return 0x0u;
    if (alpha <  767.0f / 2048.0f) return 0x8u;
    if (alpha < 1281.5f / 2048.0f) return 0x9u;
    if (alpha < 1795.5f / 2048.0f) return 0xbu;
    return 0xfu;
}

// --- Intel HD Graphics 4400 ------------------------------------------------
uint EmulatedA2C_IntelHD4400(float alpha, uint2 xy)
{
    if (alpha <= 0.5f / 4.0f) return 0x0u;
    if (alpha <= 1.5f / 4.0f) return 0x1u;
    if (alpha <= 2.5f / 4.0f) return 0x3u;
    if (alpha <= 3.5f / 4.0f) return 0x7u;
    return 0xfu;
}

// --- Apple M1 Pro (2x2 dither) --------------------------------------------
uint EmulatedA2C_AppleM1Pro(float alpha, uint2 xy)
{
    uint i = (xy.y % 2u) * 2u + (xy.x % 2u);
    const uint t00[4]  = { 0x0u, 0x0u, 0x0u, 0x0u };
    const uint t01[4]  = { 0x1u, 0x0u, 0x0u, 0x0u };
    const uint t02[4]  = { 0x1u, 0x0u, 0x0u, 0x1u };
    const uint t03[4]  = { 0x1u, 0x1u, 0x0u, 0x1u };
    const uint t04[4]  = { 0x1u, 0x1u, 0x1u, 0x1u };
    const uint t05[4]  = { 0x9u, 0x1u, 0x1u, 0x1u };
    const uint t06[4]  = { 0x9u, 0x1u, 0x1u, 0x9u };
    const uint t07[4]  = { 0x9u, 0x9u, 0x1u, 0x9u };
    const uint t08[4]  = { 0x9u, 0x9u, 0x9u, 0x9u };
    const uint t09[4]  = { 0xbu, 0x9u, 0x9u, 0x9u };
    const uint t10[4]  = { 0xbu, 0x9u, 0x9u, 0xbu };
    const uint t11[4]  = { 0xbu, 0xbu, 0x9u, 0xbu };
    const uint t12[4]  = { 0xbu, 0xbu, 0xbu, 0xbu };
    const uint t13[4]  = { 0xfu, 0xbu, 0xbu, 0xbu };
    const uint t14[4]  = { 0xfu, 0xbu, 0xbu, 0xfu };
    const uint t15[4]  = { 0xfu, 0xfu, 0xbu, 0xfu };
    if (alpha <   7.5f / 255.0f) return t00[i];
    if (alpha <  23.5f / 255.0f) return t01[i];
    if (alpha <  39.5f / 255.0f) return t02[i];
    if (alpha <  55.5f / 255.0f) return t03[i];
    if (alpha <  71.5f / 255.0f) return t04[i];
    if (alpha <  87.5f / 255.0f) return t05[i];
    if (alpha < 103.5f / 255.0f) return t06[i];
    if (alpha < 119.5f / 255.0f) return t07[i];
    if (alpha < 135.5f / 255.0f) return t08[i];
    if (alpha < 151.5f / 255.0f) return t09[i];
    if (alpha < 167.5f / 255.0f) return t10[i];
    if (alpha < 183.5f / 255.0f) return t11[i];
    if (alpha < 199.5f / 255.0f) return t12[i];
    if (alpha < 215.5f / 255.0f) return t13[i];
    if (alpha < 231.5f / 255.0f) return t14[i];
    if (alpha < 247.5f / 255.0f) return t15[i];
    return 0xfu;
}

// --- Imagination PowerVR Rogue GE8300 (same table as Apple M1 Pro) --------
uint EmulatedA2C_PowerVR_GE8300(float alpha, uint2 xy)
{
    return EmulatedA2C_AppleM1Pro(alpha, xy);
}

// --- ARM Mali-G78 (2x2 dither, 16 thresholds) -----------------------------
uint EmulatedA2C_ARMMaliG78(float alpha, uint2 xy)
{
    uint i = (xy.y % 2u) * 2u + (xy.x % 2u);
    const uint t00[4]  = { 0x0u, 0x0u, 0x0u, 0x0u };
    const uint t01[4]  = { 0x0u, 0x8u, 0x0u, 0x0u };
    const uint t02[4]  = { 0x1u, 0x8u, 0x0u, 0x0u };
    const uint t03[4]  = { 0x1u, 0x8u, 0x0u, 0x1u };
    const uint t04[4]  = { 0x1u, 0x8u, 0x8u, 0x1u };
    const uint t05[4]  = { 0x1u, 0xau, 0x8u, 0x1u };
    const uint t06[4]  = { 0x5u, 0xau, 0x8u, 0x1u };
    const uint t07[4]  = { 0x5u, 0xau, 0x8u, 0x5u };
    const uint t08[4]  = { 0x5u, 0xau, 0xau, 0x5u };
    const uint t09[4]  = { 0x5u, 0xeu, 0xau, 0x5u };
    const uint t10[4]  = { 0x7u, 0xeu, 0xau, 0x5u };
    const uint t11[4]  = { 0x7u, 0xeu, 0xau, 0x7u };
    const uint t12[4]  = { 0x7u, 0xeu, 0xeu, 0x7u };
    const uint t13[4]  = { 0x7u, 0xfu, 0xeu, 0x7u };
    const uint t14[4]  = { 0xfu, 0xfu, 0xeu, 0x7u };
    const uint t15[4]  = { 0xfu, 0xfu, 0xeu, 0xfu };
    if (alpha <  0.5f / 16.0f) return t00[i];
    if (alpha <  1.5f / 16.0f) return t01[i];
    if (alpha <  2.5f / 16.0f) return t02[i];
    if (alpha <  3.5f / 16.0f) return t03[i];
    if (alpha <  4.5f / 16.0f) return t04[i];
    if (alpha <  5.5f / 16.0f) return t05[i];
    if (alpha <  6.5f / 16.0f) return t06[i];
    if (alpha <  7.5f / 16.0f) return t07[i];
    if (alpha <  8.5f / 16.0f) return t08[i];
    if (alpha <  9.5f / 16.0f) return t09[i];
    if (alpha < 10.5f / 16.0f) return t10[i];
    if (alpha < 11.5f / 16.0f) return t11[i];
    if (alpha < 12.5f / 16.0f) return t12[i];
    if (alpha < 13.5f / 16.0f) return t13[i];
    if (alpha < 14.5f / 16.0f) return t14[i];
    if (alpha < 15.5f / 16.0f) return t15[i];
    return 0xfu;
}

